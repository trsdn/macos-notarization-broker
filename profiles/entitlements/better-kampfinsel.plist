<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Die App selbst ist nur der Traeger der Safari-Erweiterung; sie oeffnet
	     hoechstens eine vom Nutzer gewaehlte Datei, und zwar lesend. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Der Traeger zeigt eine lokale Hilfeseite und laedt deren Bilder. Ohne
	     dies bekommt eine Sandbox-App keinen ausgehenden Verkehr. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
