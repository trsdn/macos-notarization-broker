<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Bewusst ohne network.client: das Content-Script laeuft im Seitenkontext
	     von Safari, nicht im Prozess der Erweiterung. Diese haelt keine eigene
	     Verbindung und rechnet ausschliesslich mit Daten, die das Spiel bereits
	     ins Markup geschrieben hat. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
